# Generated by `python run.py data300k`, about 30 seconds. Not committed
# because it is 95 MB and reproduces exactly from the seed.
data/
data300k/

# Generated data. The three exceptions are small, deterministic, slow to
# rebuild, and the console will not build without them. No HTML lives here:
# the built pages are in demo/.
artifacts/*
!artifacts/seed_check.json
!artifacts/headline.json
!artifacts/tables.md

# Regenerating the documents in the working tree writes these; the packaged
# copy carries the same content inside docs/DOCUMENTATION.md.
docs/METRICS.md
docs/RECOVERY.md
docs/DATA_CARD.md
docs/IDEA.md

__pycache__/
*.py[cod]
*.pkl
.venv/
.pytest_cache/
.ipynb_checkpoints/
.env
